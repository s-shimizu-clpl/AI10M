# x86_64 additions to kernel.config: QEMU q35 machine on KVM, BIOS (SeaBIOS) boot.

# The kernel Makefile treats an x86_64 host as ARCH=x86, where allnoconfig
# would otherwise produce a 32-bit, uniprocessor kernel.
CONFIG_64BIT=y
CONFIG_SMP=y

# Platform discovery, MSI interrupts for virtio, and kvmclock as clocksource.
CONFIG_ACPI=y
CONFIG_PCI_MSI=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# cloud-init and systemd read /sys/class/dmi/id.
CONFIG_DMI=y
CONFIG_DMIID=y

# DPDK: the VM has no vIOMMU. VFIO no-IOMMU mode is enabled on the kernel
# command line (vfio.enable_unsafe_noiommu_mode=1); DPDK uses --iova-mode=pa.
CONFIG_VFIO_NOIOMMU=y

# CMOS RTC and 16550 serial boot console (ttyS0).
CONFIG_RTC_DRV_CMOS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
