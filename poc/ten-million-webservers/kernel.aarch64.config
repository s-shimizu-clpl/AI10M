# ARM64 additions to kernel.config: QEMU "virt" machine booted by UEFI.

# UEFI boots the kernel installed in /boot by init_vms.sh.
CONFIG_EFI=y
CONFIG_PCI_HOST_GENERIC=y

# DPDK: SMMUv3 gives VFIO an IOMMU group (iommu.passthrough=1 on the cmdline).
CONFIG_ARM_SMMU_V3=y

# PL031 RTC and PL011 serial boot console.
CONFIG_RTC_DRV_PL031=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
